---
import type {Thing, Graph} from 'schema-dts';

interface Props {
    schema?: Thing | Thing[];
}

const {schema} = Astro.props;

const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

const graphData: Graph | undefined = schemas.length > 0 ? {
    '@context': 'https://schema.org',
    '@graph': schemas,
} : undefined;

function safeJsonLd(data: unknown): string {
    return JSON.stringify(data)
        .replace(/</g, '\\u003C')
        .replace(/>/g, '\\u003E')
        .replace(/&/g, '\\u0026')
        .replace(/'/g, '\\u0027');
}
---
{graphData && <script is:inline type="application/ld+json" set:html={safeJsonLd(graphData)}/>}
