---
const canonicalURL = new URL(Astro.url.pathname, Astro.url);
const ogImage = new URL('/ogp.png', Astro.url);
const {
    title,
    description = "関西大学高槻キャンパスで活動している学生劇団で、1994年以来ダンスコメディを始めなんでもありのエンターテイメントを追求しています。",
    noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} - 劇団万絵巻`:"劇団万絵巻 - 関西大学演劇サークル";
---
<!-- Metadata -->
<link rel="canonical" href={canonicalURL}/>
<title>{pageTitle}</title>
<meta name="description" content={description}>
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
<!-- End Metadata -->
<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="劇団万絵巻" />
<meta property="og:locale" content="ja_JP" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title ? `${title}`:"劇団万絵巻"} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<!-- End Open Graph -->
<!-- X (Twitter) -->
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@Yoroduwemaki">
<!-- End X (Twitter) -->
