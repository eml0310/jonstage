---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {Image} from "astro:assets";

// Import images
import Logo from "../../../assets/logo.svg";
import background from '../../../assets/performances/2026/encadrementstar/background.avif';
import gakuTop from '../../../assets/performances/2026/encadrementstar/gaku-top.avif';
import gakuLeft from '../../../assets/performances/2026/encadrementstar/gaku-left.avif';
import gakuRight from '../../../assets/performances/2026/encadrementstar/gaku-right.avif';
import logo from '../../../assets/performances/2026/encadrementstar/logo.webp';
import ogp from '../../../assets/performances/2026/encadrementstar/ogp.png';
import NorthEast from '../../../assets/performances/2026/encadrementstar/north-east.svg';
import South from '../../../assets/performances/2026/encadrementstar/south.svg';
---
<BaseLayout title={`アンカードルモンスター - 公演`} description={`かいぶつは本物にはなれない`} ogImage={{src: ogp.src, type: "image/png", width: ogp.width, height: ogp.height}}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hina+Mincho&family=Klee+One&display=swap" rel="stylesheet">
    <div class="m_body hina-mincho-regular">
        <header class="m_header bg-grey-900 text-white">
            <nav class="m_header_area">
                <a class="m_logo h5 bg-white text-grey-900" href="/">
                    <Logo width={32} height={32}/>
                    劇団万絵巻
                </a>
                <p class="fs-18 d-none d-sm-block">2026年度 卒業公演</p>
                <a class="m_header_ticket" href="https://yorodu.corich.co/2026sotu/reserve">チケット予約 <NorthEast width={16} height={16}/></a>
            </nav>
        </header>
        <main id="top" class="bg-grey-900 text-white">
            <article>
                <section class="m_hero">
                    <div class="m_hero_art">
                        <Image fetchpriority="high" loading="eager" src={background} alt=""/>
                    </div>
                    <div class="m_hero_shade"></div>
                    <div class="m_hero_frame">
                        <Image loading="eager" class="m_hero_frame_top" src={gakuTop} alt=""/>
                        <Image loading="eager" class="m_hero_frame_left" src={gakuLeft} alt=""/>
                        <Image loading="eager" class="m_hero_frame_right" src={gakuRight} alt=""/>
                    </div>
                    <div class="m_hero_content">
                        <p class="text-blue-200 fs-18">劇団万絵巻2026年度卒業公演</p>
                        <p class="m_hero_copy klee-one-regular">かいぶつは<br/>本物にはなれない</p>
                        <h1 class="m_hero_title my-4">
                            <Image fetchpriority="high" loading="eager" src={logo} alt="アンカードルモンスター"/>
                        </h1>
                        <p class="">作・演出<span class="ml-3">ヴィクセン</span></p>
                        <div class="my-4">
                            <p class="fs-36"><span class="fs-20">2026.</span>12.11<small class="fs-20">金</small><span
                                class="fs-20"> — </span>12.13<small class="fs-20">日</small></p>
                            <p class="mt-2">大阪市立芸術創造館</p>
                        </div>
                        <a class="m_cta_btn" href="https://yorodu.corich.co/2026sotu/reserve">チケットを予約する<NorthEast width={20} height={20}/></a>
                    </div>
                    <a class="m_scroll_cue" href="#story">スクロールして続きを見る <South width={16} height={16}/></a>
                    <span class="m_hero_side">劇団万絵巻</span>
                </section>
                <nav class="m_nav" aria-label="公演情報">
                    <a href="#story">物語</a>
                    <a href="#schedule">公演日程</a>
                    <a href="#tickets">チケット</a>
                    <a href="#access">会場</a>
                    <a href="#staff">スタッフ</a>
                </nav>
                <section class="m_story_section" id="story">
                    <div class="m_section_heading">
                        <span class="text-blue-200">01 / STORY</span>
                        <h2 id="story-title" class="h2 mt-3">あらすじ</h2>
                    </div>
                    <div class="klee-one-regular fs-18">
                        <p>毎日悪夢にうなされ、生きている実感も持てない会社員の煙上冬芽は偶然届いた手紙をきっかけにとある美術館を訪れる。</p>
                        <p class="text-blue-200 mt-3">ー絵本作家・雲田真幌路の個展ー</p>
                        <p class="mt-3">しかし、そこで彼女は展示されたひとつの絵の中に引きずり込まれてしまう。辿り着いた先は、人像や塑像など「にせもの」と呼ばれる不完全な存在が集まる奇怪な塔。</p>
                        <p class="mt-3">自分自身も核となる記憶を失ったにせものだと言われた冬芽は、自分の失ったものを知り、「本物の自分」に戻るため塔へと足を踏み入れる。</p>
                        <p class="text-blue-200 mt-3">自分は何を失ってしまったのか。<br/>毎日見る悪夢は、本当に夢だったのだろうか。</p>
                    </div>
                    <span class="m_story_flame"></span>
                </section>
                <section class="m_story_section" id="schedule">
                    <div class="m_section_heading">
                        <span class="text-blue-200">02 / SCHEDULE</span>
                        <h2 id="schedule-title" class="h2 mt-3">公演スケジュール</h2>
                        <p class="m_section_note">2026年12月11日（金）— 13日（日）<br/>全4公演 ／ 大阪市立芸術創造館</p>
                    </div>
                    <div>
                        <div class="m_schedule_row"><p class="day">
                            12.11 <span>金</span></p>
                            <p>
                                <span class="m_show_number">1st</span>
                                <time datetime="2026-12-11T17:30:00+09:00">17:30</time>
                                <small>— 20:00</small>
                            </p>
                        </div>
                        <div class="m_schedule_row">
                            <p class="day">12.12 <span>土</span></p>
                            <div>
                                <p>
                                    <span class="m_show_number">2nd</span>
                                    <time datetime="2026-12-12T13:30:00+09:00">13:30</time>
                                    <small>— 16:00</small>
                                </p>
                                <p>
                                    <span class="m_show_number">3rd</span>
                                    <time datetime="2026-12-12T17:30:00+09:00">17:30</time>
                                    <small>— 20:00</small>
                                </p>
                            </div>
                        </div>
                        <div class="m_schedule_row"><p class="day">
                            12.13 <span>日</span></p>
                            <p>
                                <span class="m_show_number">4th</span>
                                <time datetime="2026-12-13T13:30:00+09:00">13:30</time>
                                <small>— 16:00</small>
                            </p>
                        </div>
                        <ul class="m_notes">
                            <li>公演時間は途中休憩10分を含め、150分を予定しています。</li>
                            <li>受付開始・開場は、各公演の開演30分前です。</li>
                        </ul>
                    </div>
                </section>
                <section class="m_story_section" id="tickets">
                    <div class="m_section_heading">
                        <span class="text-blue-200">03 / TICKETS</span>
                        <h2 id="tickets-title" class="h2 mt-3">チケット</h2>
                        <p class="m_section_note">ご予約はCoRichチケット！から。</p>
                        <a class="m_cta_btn mt-5" href="https://yorodu.corich.co/2026sotu/reserve">チケットを予約する<NorthEast width={20} height={20}/></a>
                    </div>
                    <div>
                        <dl class="m_price_list">
                            <div>
                                <dt>一般当日</dt>
                                <dd>1,800<span>円</span></dd>
                            </div>
                            <div>
                                <dt>一般前売</dt>
                                <dd>1,500<span>円</span></dd>
                            </div>
                            <div>
                                <dt>学生当日</dt>
                                <dd>1,500<span>円</span></dd>
                            </div>
                            <div>
                                <dt>学生前売</dt>
                                <dd>1,200<span>円</span></dd>
                            </div>
                            <div>
                                <dt>団体割（前売・1名様）</dt>
                                <dd>1,000<span>円</span></dd>
                            </div>
                            <div>
                                <dt>高校生以下</dt>
                                <dd>800<span>円</span></dd>
                            </div>
                        </dl>
                        <ul class="m_notes">
                            <li>学生の方は当日学生証をお持ちください。</li>
                            <li>団体割は3名様以上でのご予約が対象です。ご予約人数1名につき1,000円となります。</li>
                        </ul>
                    </div>
                </section>
                <section class="m_story_section" id="access">
                    <div class="m_section_heading">
                        <span class="text-blue-200">04 / ACCESS</span>
                        <h2 id="access-title" class="h2 mt-3">アクセス</h2>
                    </div>
                    <div>
                        <h3 class="h3">大阪市立芸術創造館</h3>
                        <p class="m_address">〒535-0003 大阪市旭区中宮1-11-14</p>
                        <a class="m_text_link" href="https://www.google.com/maps/search/?api=1&query=大阪市立芸術創造館">Googleマップで見る <NorthEast width={16} height={16}/></a>
                        <ul class="m_access_list">
                            <li><span>Osaka Metro 谷町線</span>
                                <p>「千林大宮」駅から徒歩10分 <small>約800m</small></p></li>
                            <li><span>京阪本線</span>
                                <p>「森小路」駅から徒歩10分 <small>約800m</small></p></li>
                            <li><span>JRおおさか東線</span>
                                <p>「城北公園通」駅から徒歩15分 <small>約1,100m</small></p></li>
                            <li><span>大阪シティバス</span>
                                <p>大阪駅前より83号系統「花博記念公園北口」行、または78号系統「守口車庫前」行で約30分。「旭区役所」下車すぐ。</p>
                            </li>
                        </ul>
                        <a class="m_text_link" href="https://geijutsusozokan.jp">会場公式サイト <NorthEast width={16} height={16}/></a>
                    </div>
                </section>
                <section class="m_story_section" id="staff">
                    <div class="m_section_heading">
                        <span class="text-blue-200">05 / STAFF</span>
                        <h2 id="staff-title" class="h2 mt-3">スタッフ</h2>
                        <p class="m_section_note">作・演出 ヴィクセン</p>
                    </div>
                    <dl class="m_staff_list">
                        <div>
                            <dt>舞台監督</dt>
                            <dd>たゆたゆ</dd>
                        </div>
                        <div>
                            <dt>大道具</dt>
                            <dd>シェーレ皐月、犀音</dd>
                        </div>
                        <div>
                            <dt>小道具</dt>
                            <dd>犀音</dd>
                        </div>
                        <div>
                            <dt>照明</dt>
                            <dd>つばき</dd>
                        </div>
                        <div>
                            <dt>音響</dt>
                            <dd>慧流</dd>
                        </div>
                        <div>
                            <dt>衣装</dt>
                            <dd>ことん</dd>
                        </div>
                        <div>
                            <dt>広報</dt>
                            <dd>愛媛みかん</dd>
                        </div>
                        <div>
                            <dt>制作</dt>
                            <dd>パステル</dd>
                        </div>
                    </dl>
                </section>
                <section class="m_closing" aria-label="ご予約・お問い合わせ">
                    <p class="text-blue-200 fs-18">劇団万絵巻 2026年度卒業公演</p>
                    <p class="m_closing_title klee-one-regular">アンカードルモンスター</p>
                    <p>2026.12.11(金) – 12.13(日)</p>
                    <a class="m_cta_btn" href="https://yorodu.corich.co/2026sotu/reserve">チケットを予約する<NorthEast width={20} height={20}/></a>
                    <div class="m_contact">
                        <h2 class="h5">お問い合わせ</h2>
                        <a href="mailto:mail@yoroweb.com">mail@yoroweb.com ↗</a>
                        <p>公演当日のご連絡はメールからお願いいたします。</p>
                        <div class="m_social">
                            <a href="https://x.com/Yoroduwemaki">X ↗</a>
                            <a href="https://www.instagram.com/yoroduwemaki">Instagram ↗</a>
                        </div>
                    </div>
                </section>
            </article>
        </main>
        <footer class="m_footer">
            <a href="/">劇団万絵巻</a>
            <a href="/performances/">公演一覧へ ↗</a>
            <a href="#top">ページの先頭へ ↑</a>
        </footer>
    </div>
</BaseLayout>

<style>
    .hina-mincho-regular {
        font-family: "Hina Mincho", serif;
        font-weight: 400;
        font-style: normal;
    }

    .klee-one-regular {
        font-family: "Klee One", cursive;
        font-weight: 400;
        font-style: normal;
    }

    .m_body {
        background: #1a1a1a;
        color: #e6e6e6;
        font-size: 1rem;
        line-height: 1.75;
        letter-spacing: .02rem;
        overflow: clip;
    }

    .m_body a {
        text-decoration: none;
    }

    .m_body a:focus-visible {
        outline: 2px solid #c5d7fb;
        outline-offset: 6px;
    }

    @keyframes arrive {
        from {
            opacity: 0;
            transform: translateY(18px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes descend {
        50% {
            transform: translateY(6px);
        }
    }

    .m_header {
        border-bottom: 1px solid #ffffff26;
    }

    .m_header_area {
        min-height: 68px;
        display: flex;
        padding: 0 4vw;
        justify-content: space-between;
        align-self: flex-start;
        align-items: center;
    }

    .m_logo {
        font-family: "Noto Sans JP", "Noto Sans", sans-serif;
        display: inline-flex;
        width: fit-content;
        height: fit-content;
        align-items: center;
        gap: .5rem;
        padding: .25rem .5rem;
        border-radius: 8px;
    }

    .m_hero {
        position: relative;
        min-height: min(1000px, 105svh);
        display: flex;
        align-items: center;
        isolation: isolate;
    }

    .m_hero_art {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: -1;
        left: 36%;
        overflow: hidden;

        img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center 60%;
        }
    }

    .m_hero_content {
        position: relative;
        z-index: 1;
        width: min(740px, 64%);
        padding: 80px 0 100px 7vw;
        animation: 1.4s ease-out both arrive;
    }

    .m_hero_frame {
        display: flex;
        inset: 30px 32px;
        z-index: 0;
        opacity: .65;
        position: absolute;
        pointer-events: none;
    }

    .m_hero_frame_top {
        position: absolute;
        width: 100%;
        height: 44px;
        top: 0;
        object-fit: fill;
    }

    .m_hero_frame_right {
        position: absolute;
        right: 0;
        top: 44px;
        width: 44px;
        height: 79%;
        object-fit: fill;
    }

    .m_hero_frame_left {
        position: absolute;
        left: 0;
        top: 44px;
        width: 48px;
        height: 94%;
        object-fit: fill;
    }

    .m_hero_shade {
        background: linear-gradient(90deg, #1a1a1a 15%, #1a1a1ae6 32%, #1a1a1a26 70%), linear-gradient(0deg, #1a1a1a, transparent 24%, transparent 80%, #1a1a1a80);
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: -1;
    }

    .m_hero_copy {
        margin-top: 32px;
        font-size: 3rem;
        line-height: 1.25;
    }

    .m_hero_title {
        img {
            width: 100%;
            height: auto;
        }
    }

    .m_header_ticket {
        display: flex;
        gap: 16px;
        align-items: center;
        font-size: .875rem;
        border-bottom: 1px solid #c5d7fb;
        padding: 8px 0;
    }

    .m_cta_btn {
        background: #c5d7fb;
        color: #1a1a1a;
        border: 1px solid #c5d7fb;
        display: inline-flex;
        justify-content: space-between;
        align-items: center;
        gap: 52px;
        min-height: 56px;
        padding: 16px 24px;
        font-weight: 700;
        font-size: 1rem;
        transition: background .25s, transform .25s;

        &:hover {
            background: #d9e6ff;
            transform: translateY(-2px);
        }
    }

    .m_scroll_cue {
        position: absolute;
        bottom: 24px;
        left: 8vw;
        display: flex;
        gap: 16px;
        align-items: center;
        color: #b3b3b3;
        font-size: .875rem;
    }

    .m_hero_side {
        position: absolute;
        right: 12px;
        top: 26%;
        writing-mode: vertical-rl;
        font-size: .875rem;
        color: #b3b3b3;
    }

    .m_nav {
        display: flex;
        justify-content: center;
        gap: clamp(24px, 5vw, 72px);
        padding: 24px;
        border-block: 1px solid #ffffff26;
        font-size: .875rem;
    }

    .m_story_section {
        position: relative;
        padding-block: 140px;
        max-width: 1200px;
        margin: 0 auto;
        padding: 100px 48px;
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 72px;
        border-bottom: 1px solid #ffffff26;
        scroll-margin-top: 24px;
    }

    .m_story_flame {
        position: absolute;
        top: 140px;
        left: 85px;
        width: 230px;
        height: 320px;
        border: 1px solid #cda6ff26;
        transform: rotate(-12deg);
        box-shadow: 0 0 0 12px #cda6ff05, inset 0 0 0 12px #cda6ff05;
        pointer-events: none;
    }

    .m_section_heading h2 {
        font-size: clamp(1.5rem, 2.5vw, 2rem);
        font-weight: 400;
        line-height: 1.5;
    }

    .h3 {
        font-size: 1.5rem;
        line-height: 1.5;
    }

    .m_story_section .klee-one-regular p + p {
        margin-top: 24px;
    }

    .m_section_note {
        color: #b3b3b3;
        font-size: .875rem;
        margin-top: 24px;
    }

    .m_section_heading .m_cta_btn {
        margin-top: 32px;
    }

    .m_schedule_row {
        display: grid;
        grid-template-columns: 1fr 1.5fr;
        align-items: start;
        gap: 20px;
        padding: 24px 0;
        border-bottom: 1px solid #ffffff26;
    }

    .m_schedule_row:first-child {
        border-top: 1px solid #ffffff26;
    }

    .day {
        font-size: 2rem;
        line-height: 1.5;
    }

    .day span {
        font-size: .875rem;
        margin-left: 8px;
        color: #b3b3b3;
    }

    .m_schedule_row time {
        font-size: 1.5rem;
    }

    .m_show_number {
        color: #b3b3b3;
        font-size: .875rem;
        margin-right: 16px;
    }

    .m_schedule_row small {
        font-size: .875rem;
        margin-left: 8px;
        color: #b3b3b3;
        white-space: nowrap;
    }

    .m_schedule_row div p + p {
        margin-top: 12px;
    }

    .m_notes {
        color: #b3b3b3;
        font-size: .875rem;
        margin-top: 24px;
        list-style: none;
        padding-left: 0;
    }

    .m_notes li {
        padding-left: 1em;
        position: relative;
    }

    .m_notes li::before {
        content: '※';
        position: absolute;
        left: 0;
    }

    .m_notes li + li {
        margin-top: 8px;
    }

    .m_price_list > div {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 20px;
        padding: 16px 0;
        border-bottom: 1px solid #ffffff26;
    }

    .m_price_list > div:first-child {
        border-top: 1px solid #ffffff26;
    }

    .m_price_list dd {
        font-size: 1.75rem;
        white-space: nowrap;
    }

    .m_price_list dd span {
        font-size: .875rem;
        margin-left: 8px;
    }

    .m_address {
        margin: 12px 0 20px;
        font-size: .875rem;
        color: #b3b3b3;
    }

    .m_text_link {
        display: inline-flex;
        align-items: center;
        gap: 32px;
        padding-bottom: 8px;
        border-bottom: 1px solid #c5d7fb80;
        color: #c5d7fb;
        font-size: .875rem;
        text-decoration: none;
        transition: color .2s;

        &:hover {
            color: #cda6ff;
        }
    }

    .m_access_list {
        margin: 24px 0;
        list-style: none;
        padding-left: 0;
    }

    .m_access_list li {
        padding: 18px 0;
        border-bottom: 1px solid #ffffff26;
    }

    .m_access_list li > span {
        color: #b3b3b3;
        font-size: .875rem;
    }

    .m_access_list p {
        margin-top: 4px;
    }

    .m_access_list small {
        font-size: .875rem;
        color: #b3b3b3;
        white-space: nowrap;
    }

    .m_staff_list {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px 32px;
    }

    .m_staff_list dt {
        color: #b3b3b3;
        font-size: .875rem;
        margin-bottom: 4px;
    }

    .m_closing {
        padding: 100px 24px 64px;
        text-align: center;
        background: radial-gradient(ellipse at 50% 100%, #21004b80, transparent 70%);
    }

    .m_closing_title {
        font-size: clamp(1.5rem, 4vw, 2.25rem);
        margin: 24px 0 16px;
    }

    .m_closing > .m_cta_btn {
        margin-top: 32px;
