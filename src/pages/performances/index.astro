---
import {Image} from 'astro:assets';
import {getCollection, type CollectionEntry} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ogpImage from '../../assets/ogp.avif';
import type {BreadcrumbList, CollectionPage, ItemList} from "schema-dts";
const currentUrl = new URL(Astro.url.pathname, Astro.url);

const allPerformances = await getCollection('performances');
const visiblePerformances = allPerformances.filter((p: CollectionEntry<'performances'>) => !p.data.noindex);

const sortedPerformances = visiblePerformances.sort((a: CollectionEntry<'performances'>, b: CollectionEntry<'performances'>) => {
    return new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime();
});

const performancesByYear = sortedPerformances.reduce((acc: Record<number, CollectionEntry<'performances'>[]>, performance: CollectionEntry<'performances'>) => {
    const date = new Date(performance.data.startDate);
    const year = date.getFullYear();
    if (!acc[year]) {
        acc[year] = [];
    }
    acc[year].push(performance);
    return acc;
}, {} as Record<number, CollectionEntry<'performances'>[]>);

const years = Object.keys(performancesByYear).map(Number).sort((a: number, b: number) => b - a);

const breadcrumb: BreadcrumbList = {
    '@type': 'BreadcrumbList',
    itemListElement: [
        {'@type': 'ListItem', position: 1, name: '劇団万絵巻', item: new URL('/', currentUrl.origin).toString()},
        {'@type': 'ListItem', position: 2, name: '公演', item: currentUrl.toString()},
    ],
};

const pageDescription:string = "劇団万絵巻の過去から現在までの公演一覧です。1994年の設立以来、様々な作品を上演してきました。";

const cleanString = (val?: string): string | undefined => {
    const trimmed = val?.trim();
    return trimmed && trimmed.length > 0 ? trimmed : undefined;
};

const itemList: ItemList = {
    '@type': 'ItemList',
    name: '劇団万絵巻 公演一覧',
    numberOfItems: sortedPerformances.length,
    itemListElement: sortedPerformances.map((performance, index) => {
        const itemUrl = new URL(`/performances/${performance.id}/`, currentUrl.origin).toString();
        const startDate = new Date(performance.data.startDate).toISOString().split('T')[0];
        const formattedEndDate = performance.data.endDate
            ? new Date(performance.data.endDate).toISOString().split('T')[0]
            : undefined;
        const endDate = formattedEndDate && formattedEndDate !== startDate
            ? formattedEndDate
            : undefined;

        const venueName = cleanString(performance.data.venue?.name);
        const venueAddress = cleanString(performance.data.venue?.address);
        const location = venueName ? {
            '@type': 'Place' as const,
            name: venueName,
            ...(venueAddress ? {
                address: {
                    '@type': 'PostalAddress' as const,
                    streetAddress: venueAddress,
                    addressCountry: 'JP' as const,
                },
            } : {}),
        } : undefined;

        return {
            '@type': 'ListItem',
            position: index + 1,
            item: {
                '@type': 'TheaterEvent',
                '@id': `${itemUrl}#theaterevent`,
                url: itemUrl,
                name: performance.data.name,
                startDate: startDate,
                ...(endDate ? { endDate } : {}),
                ...(location ? { location } : {}),
                performer: {
                    '@type': 'TheaterGroup',
                    '@id': 'https://yoroweb.com/#theatergroup',
                    name: '劇団万絵巻',
                },
            },
        };
    }),
};

const collectionPage: CollectionPage = {
    '@type': 'CollectionPage',
    '@id': `${currentUrl.toString()}#collectionpage`,
    url: currentUrl.toString(),
    name: '公演',
    description: pageDescription,
    inLanguage: 'ja',
    isPartOf: {
        '@type': 'WebSite',
        '@id': 'https://yoroweb.com/#website',
    },
    mainEntity: itemList,
};
---

<Layout title="公演" description={pageDescription} schema={[breadcrumb, collectionPage]}>
    <main>
        <section class="container-lg mt-5">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a class="breadcrumb-link" href="/">ホーム</a></li>
                <li class="breadcrumb-item">公演</li>
            </ol>
            <h1 class="h1">公演</h1>
        </section>
        <nav class="year-nav container-lg px-0">
            <div class="year-nav__inner">
                <ul class="year-nav__list" id="year-nav-list">
                    {years.map((year: number) => (
                        <li class="year-nav__item">
                            <a class="badge badge-outline" href={`#${year}`} data-year={year}>{year}</a>
                        </li>
                    ))}
                </ul>
            </div>
        </nav>
        {years.map((year: number) => (
            <section class="mt-6 year-section" data-year={year}>
                <div class="year-area container-lg">
                    <h2 class="year-box h2 py-2" id={year.toString()} data-year={year}>{year}年</h2>
                </div>
                <div class="container-lg mt-5 vstack">
                    {performancesByYear[year].map((performance: CollectionEntry<'performances'>) => (
                        <article class="custom-card">
                            <div class="custom-card__data">
                                <h3 class="h2">{performance.data.name}</h3>
                                <div class="hstack g-3">
                                    <time datetime={new Date(performance.data.startDate).toISOString().split('T')[0]}>
                                        {new Date(performance.data.startDate).toLocaleDateString('ja-JP', {
                                            year: 'numeric',
                                            month: 'long',
                                            day: 'numeric'
                                        })}
                                    </time>
                                    <span>{performance.data.category}</span>
                                </div>
                                <p>{performance.data.excerpt}</p>
                                <div class="hstack g-3">
                                    <ul>
                                        <li>作：{performance.data.playwright}</li>
                                        <li>演出：{performance.data.director}</li>
                                    </ul>
                                </div>
                                <a class="btn btn-fill is-sm"
                                   href={`/performances/${performance.id}/`}>詳しくみる</a>
                            </div>
                            <figure class="custom-card__img-area">
                                <Image class="custom-card__img"
                                       src={performance.data.thumbnail ?? performance.data.flyer?.front ?? ogpImage}
                                       alt={performance.data.name}/>
                            </figure>
                        </article>
                    ))}
                </div>
            </section>
        ))}
        <section class="bg-grey-100 py-6 mt-6">
            <div class="container-lg">
                <h2 class="h2 mb-3">私たちの公演の歴史</h2>
                <p class="mb-3">1994年の劇団設立以来、古典的な作品から現代的な作品まで、様々な舞台を制作してきました。</p>
                <p class="">公演履歴の詳細情報や、研究目的のためのアーカイブ資料のリクエストについては、<a href="/contact/" class="link">お問い合わせ</a>ください。</p>
            </div>
        </section>
    </main>
</Layout>

<script>
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.year-nav a[data-year]');
    const sections = document.querySelectorAll<HTMLElement>('.year-section');

    if (navLinks.length && sections.length) {
        let activeYear = '';

        const setActive = (year: string) => {
            if (year === activeYear) return;
            activeYear = year;

            navLinks.forEach((link) => {
                const isActive = link.dataset.year === year;
                link.classList.toggle('badge-fill', isActive);
                if (isActive) {
                    link.scrollIntoView({ behavior: 'instant', block: 'nearest', inline: 'center' });
                }
            });
        };

        const visibleSections = new Set<HTMLElement>();

        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    const el = entry.target as HTMLElement;
                    if (entry.isIntersecting) {
                        visibleSections.add(el);
                    } else {
                        visibleSections.delete(el);
                    }
                }

                for (const section of sections) {
                    if (visibleSections.has(section)) {
                        const year = section.dataset.year ?? section.querySelector('h2[id]')?.id;
                        if (year) {
                            setActive(year);
                            break;
                        }
                    }
                }
            },
            {
                rootMargin: '-80px 0px -20% 0px',
                threshold: 0,
            }
        );

        sections.forEach((section) => observer.observe(section));
    }
</script>

<style>
    .year-area {
        position: relative;
    }
    .year-box {
        border-bottom: 1px solid #1a1a1a;
    }

    .year-box::after {
        content: attr(data-year);
        position: absolute;
        pointer-events: none;
        right: 1rem;
        color: #ffffff;
        -webkit-text-stroke: 2px rgb(0 0 0 / 0.25);
        font-size: clamp(2.5rem, 6vw, 4rem);
        transform: translateY(-25%);
    }

    .year-nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255, 255, 255, .92);
        backdrop-filter: blur(8px);
        border-bottom: 1px dashed #e0e0e0;
        margin-top: 1rem;
    }

    .year-nav__inner {
        overflow-x: auto;
        scrollbar-width: thin;
    }

    .year-nav__list {
        display: flex;
        flex-wrap: nowrap;
        gap: .5rem;
        list-style: none;
        margin: 0;
        padding: .625rem 1rem;
        width: max-content;
        min-width: 100%;
    }

    .year-box,
    .year-section {
        scroll-margin-top: 4.5rem;
    }

    .custom-card {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        border-bottom: 1px dashed #1a1a1a;
        padding: 2rem 0;
    }

    .custom-card:last-child {
        border-bottom: none;
    }

    .custom-card__img-area {
        order: 1;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .custom-card__img {
        margin: 0 auto;
        width: auto;
        max-width: 100%;
        max-height: 280px;
        object-fit: contain;
    }

    .custom-card__data {
        order: 2;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: .75rem;
    }

    .custom-card__data .hstack {
        flex-wrap: wrap;
    }

    .custom-card__data .btn {
        align-self: flex-start;
        margin-top: .25rem;
    }

    @media screen and (min-width: 768px) {
        .year-box,
        .year-section {
            scroll-margin-top: 6rem;
        }

        .custom-card {
            display: grid;
            grid-template-columns: minmax(200px, 280px) 1fr;
            grid-template-areas: "img data";
            gap: 2rem;
            padding: 2.5rem 0;
        }

        .custom-card__img-area {
            grid-area: img;
            order: unset;
        }

        .custom-card__img {
            max-height: 280px;
        }

        .custom-card__data {
            grid-area: data;
            order: unset;
            padding: 0;
            gap: .5rem;
        }
    }

    @media screen and (min-width: 1280px) {
        .custom-card {
            grid-template-columns: minmax(260px, 425px) 1fr;
            gap: 2.5rem;
        }

        .custom-card__img {
            max-height: 325px;
        }
    }
</style>
