---
const currentUrl = new URL(Astro.url.pathname, Astro.url);
import Layout from "../../../../layouts/Layout.astro";
import {getCollection, render} from "astro:content";
import {Image} from "astro:assets";
import Xlogo from '../../../../assets/x-logo.svg';
import Instagram from '../../../../assets/instagram.svg';

export async function getStaticPaths() {
    const teams = await getCollection("summerTeams");
    return teams.map((entry) => {
        const [year, team] = entry.id.split("/");
        return {params: {year, team}, props: {entry}};
    });
}

const {entry} = Astro.props;
const {Content} = await render(entry);
const [year, team] = entry.id.split("/");

const diaries = (await getCollection("summerDiaries"))
    .filter(({id}) => id.startsWith(`${year}/${team}/`))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

import type {BreadcrumbList} from "schema-dts";

const breadcrumb: BreadcrumbList = {
    '@type': 'BreadcrumbList',
    itemListElement: [
        {'@type': 'ListItem', position: 1, name: '劇団万絵巻', item: new URL('/', currentUrl.origin).toString()},
        {'@type': 'ListItem', position: 2, name: '夏季自主研究発表', item: new URL('/summer/', currentUrl.origin).toString()},
        {'@type': 'ListItem', position: 3, name: `${entry.data.year}年`, item: new URL(`/summer/#${entry.data.year}`, currentUrl.origin).toString()},
        {'@type': 'ListItem', position: 4, name: entry.data.name},
    ],
}
---
<Layout title={`${entry.data.name} - ${entry.data.year}年夏季自主研究発表チーム`} description={`劇団万絵巻${entry.data.year}年夏季自主研究発表チーム「${entry.data.name}」のページです。団員・OB/OG向け公演に向けた日記やSNS情報を掲載しています。(本公演は関係者限定です)`} schema={[breadcrumb]}>
    <main class="">
        <article class="mt-5">
            <div class="container-md">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item">
                        <a class="breadcrumb-link" href="/">ホーム</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a class="breadcrumb-link" href="/summer/">夏季自主研究発表</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a class="breadcrumb-link" href={`/summer/#${entry.data.year}`}>{entry.data.year}年</a>
                    </li>
                    <li class="breadcrumb-item">{entry.data.name}</li>
                </ol>
                <h1 class="h1">{entry.data.name}</h1>
                {entry.data.director && (
                        <p class="mt-2">演出: {entry.data.director}</p>
                )}
                <div class="hstack g-3 mt-3">
                    {entry.data.twitter && (<a class="d-flex" href={entry.data.twitter}>
                        <Xlogo width={28} height={28}/>
                    </a>)}
                    {entry.data.instagram && (<a class="d-flex" href={entry.data.instagram}>
                        <Instagram width={28} height={28}/>
                    </a>)}
                </div>
                <p class="mt-3 mb-3"><a class="link" href="#diary">日記</a></p>
            </div>
            {entry.data.thumbnail && (
                    <figure class="image-area container-sm">
                        <Image
                                src={entry.data.thumbnail}
                                alt={entry.data.name}
                        />
                    </figure>
            )}
            <div class="container-md mt-4 mb-6">
                <h2 id="diary" class="h2 mb-4">日記</h2>
                <ol class="diary-timeline">
                    {diaries.map((diary) => {
                        const diarySlug = diary.id.split("/")[2];
                        return (
                                <li class="diary-timeline-item">
                                    <a class="diary-timeline-link" href={`/summer/${year}/${team}/${diarySlug}/`}>
                                        <time class="" datetime={diary.data.date.toISOString().split("T")[0]}>
                                            {diary.data.date.toLocaleDateString("ja-JP", {
                                                month: "long",
                                                day: "numeric",
                                            })}
                                        </time>
                                        <span class="">{diary.data.title}</span>
                                    </a>
                                </li>
                        );
                    })}
                </ol>
            </div>
        </article>
    </main>
</Layout>

<style>
    .image-area {
        width: 100%;
        height: auto;

        img {
            width: 100%;
            object-fit: cover;
            height: auto;
        }
    }

    .diary-timeline {
        list-style: none;
        margin: 0;
        padding: 0;
        position: relative;
    }

    .diary-timeline-item {
        position: relative;
        padding-left: 1.5rem;
    }

    /* 縦線 */
    .diary-timeline-item::before {
        content: "";
        position: absolute;
        left: 4px;
        top: 0.6rem;
        bottom: -0.5rem;
        width: 1px;
        background: var(--bs-border-color, #dee2e6);
    }

    .diary-timeline-item:last-child::before {
        display: none;
    }

    /* 丸ポイント */
    .diary-timeline-item::after {
        content: "";
        position: absolute;
        left: 0;
        top: 35%;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: currentColor;
    }

    .diary-timeline-link {
        display: flex;
        align-items: baseline;
        gap: 1rem;
        padding: 0.6rem 0.75rem;
        border-radius: 8px;
        text-decoration: none;
        color: inherit;
        transition: background-color 0.15s ease;
    }

    .diary-timeline-link:hover {
        background: var(--bs-light, #f8f9fa);
    }

    .diary-timeline-date {
        flex-shrink: 0;
        width: 5.5em;
        font-size: 0.85rem;
        color: var(--bs-secondary, #6c757d);
    }

    .diary-timeline-title {
        font-size: 1rem;
        font-weight: 600;
    }
</style>