---
import {getCollection, render} from "astro:content";
import Layout from "../../layouts/Layout.astro";
import type {BlogPosting, BreadcrumbList} from "schema-dts";

const currentUrl = new URL(Astro.url.pathname, Astro.url);

function toSlug(date: Date) {
    return date.toISOString().split("T")[0];
}

function toYearAnchor(date: Date) {
    return `/diary/${date.getFullYear()}/#${toSlug(date)}`;
}

export async function getStaticPaths() {
    const toSlugInner = (date: Date) => date.toISOString().split("T")[0];

    const sorted = (await getCollection("diary")).sort(
        (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
    );

    return sorted.map((entry, index) => ({
        params: {date: toSlugInner(entry.data.date)},
        props: {
            entry,
            prevEntry: sorted[index - 1] ?? null,
            nextEntry: sorted[index + 1] ?? null,
        },
    }));
}

const {entry, prevEntry, nextEntry} = Astro.props;
const {Content} = await render(entry);

const dateFormatter = new Intl.DateTimeFormat("ja-JP", {
    year: "numeric",
    month: "long",
    day: "numeric",
});

const breadcrumb: BreadcrumbList = {
    '@type': 'BreadcrumbList',
    itemListElement: [
        {'@type': 'ListItem', position: 1, name: '劇団万絵巻', item: new URL('/', currentUrl.origin).toString()},
        {'@type': 'ListItem', position: 2, name: '劇団員日記', item: new URL('/diary/', currentUrl.origin).toString()},
        {
            '@type': 'ListItem',
            position: 3,
            name: `${entry.data.date.getFullYear()}年`,
            item: new URL(`/diary/${entry.data.date.getFullYear()}/`, currentUrl.origin).toString()
        },
        {'@type': 'ListItem', position: 4, name: entry.data.title},
    ],
}
function createDescription(body: string | undefined, title: string, date: Date, maxLength = 160): string {
    if (!body || typeof body !== 'string') {
        return `${dateFormatter.format(date)}に公開された劇団万絵巻の劇団員日記「${title}」です。`;
    }
    const plainText = body
        .replace(/!\[.*?\]\(.*?\)/g, '')
        .replace(/\[(.*?)\]\(.*?\)/g, '$1')
        .replace(/[#*`_~>]/g, '')
        .replace(/<[^>]+>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

    if (plainText.length < 20) {
        return `${dateFormatter.format(date)}に公開された劇団万絵巻の劇団員日記「${title}」です。`;
    }

    return plainText.length > maxLength
        ? `${plainText.slice(0, maxLength)}…`
        : plainText;
}

const description = createDescription(entry.body, entry.data.title, entry.data.date);

const blogposting: BlogPosting = {
    '@type': 'BlogPosting',
    headline: entry.data.title,
    datePublished: entry.data.date.toISOString(),
    description: description,
    inLanguage: 'ja',
    publisher: {
        '@type': 'TheaterGroup',
        '@id': 'https://yoroweb.com/#theatergroup',
    },
    isPartOf: {
        '@type': 'Blog',
        '@id': 'https://yoroweb.com/diary/#blog',
        name: '劇団員日記',
        publisher: {
            '@id': 'https://yoroweb.com/#theatergroup',
        },
    },
}
---

<Layout title={`${entry.data.title} - 劇団員日記`} description={description} schema={[breadcrumb, blogposting]}>
    <main class="mt-5">
        <article>
            <div class="container-md">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a class="breadcrumb-link" href="/">ホーム</a></li>
                    <li class="breadcrumb-item"><a class="breadcrumb-link" href="/diary/">劇団員日記</a></li>
                    <li class="breadcrumb-item">
                        <a class="breadcrumb-link" href={toYearAnchor(entry.data.date)}>
                            {entry.data.date.getFullYear()}年
                        </a>
                    </li>
                    <li class="breadcrumb-item">{entry.data.title}</li>
                </ol>
                <h1 class="h1 mb-2">{entry.data.title}</h1>
                <div class="hstack g-3">
                    {entry.data.event_name && (
                            <p class="order-2"><i class="ail-documents"></i> {entry.data.event_name}</p>
                    )}
                    <time class="order-1" datetime={entry.data.date.toISOString()}>
                        {dateFormatter.format(entry.data.date)}
                    </time>
                </div>
            </div>

            <div class="mt-4 content container-sm">
                <Content/>
                <hr class="mt-3 divider w-25"/>
            </div>

            <footer class="container-md mt-5 pb-6">
                <nav class="page-navigation flex-wrap">
                    {prevEntry ? (
                            <a class="page-navigation-item prev vstack g-2"
                               href={`/diary/${toSlug(prevEntry.data.date)}/`}>
                                <span class="mr-auto text-black fs-14 fw-n">{dateFormatter.format(prevEntry.data.date)}</span>
                                <span class="mr-auto fs-16">{prevEntry.data.title}</span>
                            </a>
                    ) : (
                            <span class="page-navigation-item-emp"></span>
                    )}
                    {nextEntry ? (
                            <a class="page-navigation-item next vstack g-2"
                               href={`/diary/${toSlug(nextEntry.data.date)}/`}>
                                <span class="ml-auto text-black fs-14 fw-n">{dateFormatter.format(nextEntry.data.date)}</span>
                                <span class="ml-auto fs-16">{nextEntry.data.title}</span>
                            </a>
                    ) : (
                            <span class="page-navigation-item-emp"></span>
                    )}
                </nav>
            </footer>
        </article>
    </main>
</Layout>
