---
import {getCollection, render} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import type {BreadcrumbList, CollectionPage, ItemList} from "schema-dts";
const currentUrl = new URL(Astro.url.pathname, Astro.url);

export async function getStaticPaths() {
    const diaryEntries = await getCollection('diary');

    const years = [...new Set(diaryEntries.map(entry => entry.data.date.getFullYear().toString()))];
    return years.map(year => {
        const entriesInYear = diaryEntries
            .filter(entry => entry.data.date.getFullYear().toString() === year)
            .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
        return {
            params: {year},
            props: {year, entries: entriesInYear},
        };
    });
}

const {year, entries} = Astro.props;

const entriesWithContent = await Promise.all(
    entries.map(async (entry) => {
        const {Content} = await render(entry);
        return {entry, Content};
    })
);

const allEntries = await getCollection('diary');
const years = [...new Set(allEntries.map(entry => entry.data.date.getFullYear()))].sort((a, b) => b - a);

const formatDate = (date: Date) => {
    return date.toLocaleDateString('ja-JP', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
    });
};

const breadcrumb: BreadcrumbList = {
    '@type': 'BreadcrumbList',
    itemListElement: [
        {'@type': 'ListItem', position: 1, name: '劇団万絵巻', item: new URL('/', currentUrl.origin).toString()},
        {'@type': 'ListItem', position: 2, name: '劇団員日記', item: new URL('/diary/', currentUrl.origin).toString()},
        {'@type': 'ListItem', position: 3, name: `${year}年の劇団員日記`},
    ],
}

const pageDescription = `${year}年に公開された劇団万絵巻の日記一覧です。舞台制作の舞台裏や稽古風景、関西大学総合情報学部の日常など劇団員それぞれの想いを綴った日記全${entries.length}件を掲載しています。`;

const itemList: ItemList = {
    '@type': 'ItemList',
    name: `${year}年の劇団員日記一覧`,
    numberOfItems: entries.length,
    itemListElement: entries.map((item, index) => {
        const slug = item.data.date.toISOString().split('T')[0];
        const itemUrl = new URL(`/diary/${slug}/`, currentUrl.origin).toString();
        return {
            '@type': 'ListItem',
            position: index + 1,
            item: {
                '@type': 'BlogPosting',
                '@id': `${itemUrl}#blogposting`,
                url: itemUrl,
                headline: item.data.title,
                datePublished: item.data.date.toISOString(),
            },
        };
    }),
};

const collectionPage: CollectionPage = {
    '@type': 'CollectionPage',
    '@id': `${currentUrl.toString()}#collectionpage`,
    url: currentUrl.toString(),
    name: `${year}年の劇団員日記`,
    description: pageDescription,
    inLanguage: 'ja',
    isPartOf: {
        '@type': 'Blog',
        '@id': 'https://yoroweb.com/diary/#blog',
        name: '劇団員日記',
    },
    mainEntity: itemList,
};
---

<Layout title={`${year}年の劇団員日記`} description={pageDescription} schema={[breadcrumb, collectionPage]}>
    <main class="mt-5">
        <section class="">
            <div class="container-md">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a class="breadcrumb-link" href="/">ホーム</a></li>
                    <li class="breadcrumb-item"><a class="breadcrumb-link" href="/diary/">劇団員日記</a></li>
                    <li class="breadcrumb-item">{year}年</li>
                </ol>
                <h1 class="h1">{year}年の劇団員日記</h1>
                <ul class="utilitylink-units mt-3 flex-wrap">
                    {years.map(y => (
                        <li class="utilitylink-item">
                            <a href={`/diary/${y}/`} class="utilitylink">{y}年</a>
                        </li>
                    ))}
                </ul>
                <details class="disclosure mt-3">
                    <summary class="disclosure-header">目次 - テーブル表示（{entries.length}件）</summary>
                    <div class="disclosure-body">
                        <table class="w-100">
                            <thead>
                            <tr>
                                <th>日付</th>
                                <th>タイトル</th>
                            </tr>
                            </thead>
                            <tbody>
                            {entries.map(item => (
                                <tr>
                                    <td style="width: 130px;">
                                        <time class=""
                                              datetime={item.data.date.toISOString()}>{formatDate(item.data.date)}</time>
                                    </td>
                                    <td><a class="link"
                                           href={`/diary/${item.data.date.toISOString().split('T')[0]}/`}>{item.data.title}</a>
                                    </td>
                                </tr>
                            ))}
                            </tbody>
                        </table>
                    </div>
                </details>
            </div>
            <div class="container-sm mt-4 vstack g-5">
                {entriesWithContent.map(({entry, Content}) => (
                    <article class="">
                        <h2 id={entry.data.date.toISOString().split('T')[0]} class="h2 mb-3">
                            <a class="link"
                               href={`/diary/${entry.data.date.toISOString().split('T')[0]}/`}>{entry.data.title}</a>
                        </h2>
                        <div class="hstack g-3">
                            {entry.data.event_name && (
                                <p class="order-2"><i class="ail-documents"></i> {entry.data.event_name}</p>
                            )}
                            <time class="order-1" datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
                        </div>
                        <div class="mt-3 content">
                            <Content/>
                        </div>
                        <hr class="mt-3 divider w-25">
                    </article>
                ))}
            </div>
            <div class="container-md mt-5 mb-6">
                <p class="h4">{year}年の劇団員日記をお届けしました。</p>
                <ul class="utilitylink-units mt-3 flex-wrap">
                    {years.map(y => (
                        <li class="utilitylink-item">
                            <a href={`/diary/${y}/`} class="utilitylink">{y}年</a>
                        </li>
                    ))}
                </ul>
            </div>
        </section>
    </main>
</Layout>
