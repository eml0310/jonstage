---
import Layout from "../../layouts/Layout.astro";
import {getCollection, render} from "astro:content";
import type {Blog, BreadcrumbList} from "schema-dts";
const currentUrl = new URL(Astro.url.pathname, Astro.url);

const diaryEntries = (await getCollection("diary")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const years = [...new Set(diaryEntries.map((e) => e.data.date.getFullYear()))].sort(
    (a, b) => b - a
);

const latestEntries = await Promise.all(
    diaryEntries.slice(0, 25).map(async (entry) => ({
        ...entry,
        slug: entry.data.date.toISOString().split("T")[0],
        Content: (await render(entry)).Content,
    }))
);

const dateFormatter = new Intl.DateTimeFormat("ja-JP", {
    year: "numeric",
    month: "long",
    day: "numeric",
});

const breadcrumb: BreadcrumbList = {
    '@type': 'BreadcrumbList',
    itemListElement: [
        {'@type': 'ListItem', position: 1, name: '劇団万絵巻', item: new URL('/', currentUrl.origin).toString()},
        {'@type': 'ListItem', position: 2, name: '劇団員日記'},
    ],
}

const blog: Blog = {
    '@type': 'Blog',
    '@id': 'https://yoroweb.com/diary/#blog',
    url: currentUrl.toString(),
    name: '劇団員日記',
    description: '2005年から劇団員が書いてきた日記、各公演の様子や裏話、関西大学総合情報学部の日常などを綴っています。',
    inLanguage: 'ja',
    publisher: {
        '@type': 'TheaterGroup',
        '@id': 'https://yoroweb.com/#theatergroup',
    },
    isPartOf: {
        '@type': 'WebSite',
        '@id': 'https://yoroweb.com/#website',
    },
    blogPost: latestEntries.map(({data, slug}) => ({
        '@type': 'BlogPosting',
        '@id': new URL(`/diary/${slug}/#blogposting`, currentUrl.origin).toString(),
        url: new URL(`/diary/${slug}/`, currentUrl.origin).toString(),
        headline: data.title,
        datePublished: data.date.toISOString(),
    })),
};
---

<Layout title="劇団員日記" description="2005年から劇団員が書いてきた日記、各公演の様子や裏話、関西大学総合情報学部の日常などを綴っています。" schema={[breadcrumb, blog]}>
    <main>
        <section class="container-md mt-5">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a class="breadcrumb-link" href="/">ホーム</a></li>
                <li class="breadcrumb-item">劇団員日記</li>
            </ol>
            <h1 class="h1">劇団員日記</h1>
            <ul class="utilitylink-units mt-3 flex-wrap">
                {years.map((year) => (
                        <li class="utilitylink-item">
                            <a href={`/diary/${year}/`} class="utilitylink">{year}年</a>
                        </li>
                ))}
            </ul>
            <p class="text-right">最新25件 / 全{diaryEntries.length}件</p>
        </section>

        <section class="container-sm mt-4 mb-6 vstack g-5">
            {latestEntries.map(({data, slug, Content}) => (
                    <article>
                        <h2 class="h2 mb-3">
                            <a class="link" href={`/diary/${slug}/`}>{data.title}</a>
                        </h2>
                        <div class="hstack g-3">
                            {data.event_name && (
                                    <p class="order-2"><i class="ail-documents"></i> {data.event_name}</p>
                            )}
                            <time class="order-1" datetime={data.date.toISOString()}>
                                {dateFormatter.format(data.date)}
                            </time>
                        </div>
                        <div class="mt-3 content">
                            <Content/>
                        </div>
                        <hr class="mt-3 divider w-25"/>
                    </article>
            ))}
        </section>
    </main>
</Layout>
