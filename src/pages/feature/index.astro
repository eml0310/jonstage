---
const currentUrl = new URL(Astro.url.pathname, Astro.url);
import Layout from "../../layouts/Layout.astro";
import {getCollection} from "astro:content";
import {Image} from "astro:assets";
import fallbackThumbnail from "../../assets/ogp.avif";
const features = (await getCollection("feature")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const formatDate = (date: Date) =>
    new Intl.DateTimeFormat("ja-JP", {dateStyle: "long"}).format(date);

import type {BreadcrumbList} from "schema-dts";

const breadcrumb: BreadcrumbList = {
    '@type': 'BreadcrumbList',
    itemListElement: [
        {'@type': 'ListItem', position: 1, name: '劇団万絵巻', item: new URL('/', currentUrl.origin).toString()},
        {'@type': 'ListItem', position: 2, name: '特集'},
    ],
}
---
<Layout title="特集" description="舞台の上だけじゃない、劇団万絵巻の「もうひとつの顔」を特集記事でご紹介します。ここでしか読めない魅力を、ぜひ覗いてみてください。" schema={[breadcrumb]}>
    <main class="">
        <section class="container-lg mt-5">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a class="breadcrumb-link" href="/">ホーム</a></li>
                <li class="breadcrumb-item">特集</li>
            </ol>
            <h1 class="h1 page-title">特集</h1>
            <p class="mt-4 fs-18">舞台の上だけじゃない、劇団万絵巻の「もうひとつの顔」を特集記事でご紹介します。<br/>ここでしか読めない魅力を、ぜひ覗いてみてください。
            </p>
        </section>
        <section class="container-lg mb-6 mt-5">
            <h2 class="visually-hidden">特集記事一覧</h2>
            <div class="f-grid-area">
                {features.map(({id, data}) => (
                    <article class="f-card">
                        <figure class="f-card-imgbox">
                            <Image src={data.thumbnail ?? fallbackThumbnail} alt={data.title}/>
                        </figure>
                        <div class="f-card-content">
                            <h3 class="h4 mb-2">
                                <a class="f-card-link" href={`/feature/${id}/`}>{data.title}</a>
                            </h3>
                            {data.description && <p class="">{data.description}</p>}
                        </div>
                        <div class="f-card-footer">
                            <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
                        </div>
                    </article>
                ))}
            </div>
        </section>
    </main>
</Layout>

<style>
    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .f-grid-area {
        display: grid;
        column-gap: 34px;
        row-gap: 50px;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    }

    .page-title {
        display: inline-block;
        font-size: 57px;
        background: #ffffff;
        padding: 8px 80px 8px 22px;
        border: 3px solid #1a1a1a;
        box-shadow: 8px 8px 0 #1a1a1a, 8px 8px 0 3px #ffffff;
        transform: rotate(-1deg);
    }

    .f-card {
        position: relative;
        display: grid;
        grid-row: span 3;
        grid-template-rows: subgrid;
        gap: 0;
        border: 3px solid #1a1a1a;
        box-shadow: 7px 7px 0 #1a1a1a;
        background: #ffffff;
        transition: transform 0.15s ease-out, box-shadow 0.15s ease-out;
    }

    .f-card:hover,
    .f-card:focus-within {
        transform: translate(-3px, -3px);
        box-shadow: 11px 11px 0 #1a1a1a;
    }

    .f-card:active {
        transform: translate(3px, 3px);
        box-shadow: 3px 3px 0 #1a1a1a;
    }

    .f-card-imgbox {
        grid-row: 1;
        max-width: 100%;
        height: auto;

        img {
            aspect-ratio: 16/9;
            object-fit: cover;
            max-width: 100%;
            height: auto;
        }
    }

    .f-card-content {
        grid-row: 2;
        padding: 1rem;
        border-top: 3px solid #1a1a1a;
    }

    .f-card-footer {
        grid-row: 3;
        padding: 0.5rem 1rem 1rem;
        border-top: 3px dashed #1a1a1a;
    }

    .f-card-link {
        &::before {
            content: "";
            cursor: inherit;
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 0;
            width: 100%;
            height: 100%;
        }
    }
</style>
