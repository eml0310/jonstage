---
import auiVersion from 'asagaoui/package.json';
import Matomo from '../components/head/Matomo.astro';
import Meta from '../components/head/Meta.astro';
import Favicon from "../components/head/Favicon.astro";
import SchemaOrg from "../components/head/SchemaOrg.astro";
const AUI_VERSION = auiVersion.version;

if (import.meta.env.DEV) {
    import('asagaoui/dist/css/asagaoui.css');
    import('asagaoui/dist/css/asagaoui-icons.css');
}

const props = Astro.props;
---
<!doctype html>
<html lang="ja">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    {import.meta.env.PROD && (
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin/>
    )}
    <meta name="generator" content={Astro.generator}/>
    <SchemaOrg schema={props.schema}/>
    <Meta {...props} />
    {import.meta.env.PROD && (
        <link href={`https://cdn.jsdelivr.net/npm/asagaoui@${AUI_VERSION}/dist/css/asagaoui.min.css`} rel="stylesheet"/>
        <link href={`https://cdn.jsdelivr.net/npm/asagaoui@${AUI_VERSION}/dist/css/asagaoui-icons.min.css`} rel="stylesheet"/>
        <script is:inline type="module" src={`https://cdn.jsdelivr.net/npm/asagaoui@${AUI_VERSION}/dist/js/asagaoui.min.js`}/>
    )}
    <Matomo />
    <Favicon />
    <!-- polyfill automatically -->
    <script type="module" async src="https://unpkg.com/invokers-polyfill@latest/invoker.min.js"></script>
</head>
<body class="aui">
<slot/>
</body>
</html>
