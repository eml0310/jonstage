---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const props = Astro.props;
---
<BaseLayout {...props}>
    <Header/>
    <slot/>
    <Footer/>
</BaseLayout>
<style is:global>
  .content {
    img {
      max-width: 100%;
      height: auto;
    }
  }
</style>
